{
  "name": "example_patch_opt",
  "task_type": "opt",
  "optimization": {
    "work_dir": "../temp",
    "project_suffix": "_work",
    "save_best_on_exit": true,
    "save_interval": 1,
    "initial_point": [1.04, 1.37, 0.25]
  },
  "launch": {
    "dashboard": true,
    "dashboard_browser": true,
    "silent": false,
    "dashboard_port": 8765
  },
  "parameters": [
    {
      "name": "patch_x",
      "min": 0.99,
      "max": 1.10,
      "unit": "mm",
      "resolution": 0.01
    },
    {
      "name": "patch_y",
      "min": 1.32,
      "max": 1.42,
      "unit": "mm",
      "resolution": 0.01
    },
    {
      "name": "probe_p",
      "min": 0.25,
      "max": 0.50,
      "unit": "mm",
      "resolution": 0.01,
      "constraint": "probe_p <= patch_x / 2"
    }
  ],
  "target": {
    "freq_band": [59, 61],
    "s11_threshold": -15,
    "bandwidth_target": null,
    "gain_min": null
  },
  "algorithm": {
    "method": "cmaes",
    "mode": "local",
    "max_iterations": 50,
    "early_stop_patience": 10,
    "max_simulations": 50
  },
  "simulator": {
    "hfss": {
      "project_path": "../hfss/patch.aedt",
      "design_name": "base",
      "setup_name": "Setup1",
      "sweep_name": "Sweep",
      "new_desktop": true,
      "non_graphical": true,
      "close_projects": 0,
      "close_desktop": 0,
      "results": {
        "s11": "dB(S(1,1))",
        "freq_unit": "GHz"
      }
    }
  },
  "output": {
    "save_csv": true,
    "output_dir": "../runs",
    "plot_s11": true
  }
}