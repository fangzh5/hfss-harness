{
  "name": "template_bo",
  "task_type": "opt",
  "optimization": {
    "work_dir": "../temp",
    "project_suffix": "_work",
    "save_best_on_exit": true,
    "save_interval": 10,
    "initial_point": [
      1.01,
      1.37
    ],
    "keep_working_copy": false
  },
  "launch": {
    "dashboard": true,
    "dashboard_browser": true,
    "silent": false,
    "dashboard_port": 8765
  },
  "parameters": [
    {
      "name": "patch_x",
      "min": 0.9,
      "max": 1.5,
      "unit": "mm",
      "resolution": 0.01
    },
    {
      "name": "patch_y",
      "min": 1.3,
      "max": 1.65,
      "unit": "mm",
      "resolution": 0.01
    }
  ],
  "target": {
    "freq_band": [
      59,
      61
    ],
    "s11_threshold": -10,
    "bandwidth_target": null,
    "gain_min": null
  },
  "algorithm": {
    "method": "bo",
    "strategy": "tr",
    "n_initial": 6,
    "acquisition": "log_ei",
    "raw_samples": 128,
    "num_restarts": 8,
    "max_iterations": 30,
    "early_stop_patience": 10,
    "max_simulations": 30
  },
  "history": {
    "mode": "off",
    "sources": []
  },
  "simulator": {
    "hfss": {
      "project_path": "../hfss/patch.aedt",
      "design_name": "base",
      "setup_name": "Setup1",
      "sweep_name": "Sweep",
      "new_desktop": true,
      "non_graphical": true,
      "close_projects": true,
      "close_desktop": true,
      "results": {
        "s11": "dB(S(1,1))",
        "freq_unit": "GHz"
      },
      "aedt_version": "2023.2",
      "use_grpc_api": false,
      "expected_freq_band": [
        55,
        65
      ],
      "min_band_points": 41
    }
  },
  "output": {
    "save_csv": true,
    "output_dir": "../runs",
    "plot_s11": true
  }
}
